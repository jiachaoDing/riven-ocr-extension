{
  "manifest_version": 3,
  "name": "Riven OCR",
  "version": "1.0.0",
  "description": "Extract Warframe Riven mod stats from screenshots and auto-fill warframe.market auction forms.",

  "author": "DingJC",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/favicon-96x96.png",
      "32": "icons/favicon-96x96.png",
      "48": "icons/favicon-96x96.png",
      "128": "icons/web-app-manifest-192x192.png"
    }
  },

  "icons": {
    "16": "icons/favicon-96x96.png",
    "32": "icons/favicon-96x96.png",
    "48": "icons/favicon-96x96.png",
    "128": "icons/web-app-manifest-192x192.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["storage"],

  "host_permissions": [
    "https://warframe.market/*",
    "https://lab.webutilitykit.com/*",
    "http://104.156.254.37:80/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://warframe.market/*"],
      "js": ["content-script-loader.js"]
    }
  ],

  "minimum_chrome_version": "88",

  "web_accessible_resources": [
    {
      "resources": ["content-script.js", "chunks/*"],
      "matches": ["https://warframe.market/*"]
    },
    {
      "resources": ["icons/*"],
      "matches": ["https://warframe.market/*"]
    }
  ]
}
