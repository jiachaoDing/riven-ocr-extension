{
  "manifest_version": 3,
  "name": "紫卡助手",
  "version": "1.0.3",
  "description": "自动识别 Warframe 紫卡并填入 warframe.market 拍卖表单。",

  "author": "yinb9933@gmail.com",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/favicon-96x96.png",
      "32": "icons/favicon-96x96.png",
      "48": "icons/favicon-96x96.png",
      "128": "icons/web-app-manifest-192x192.png"
    }
  },

  "icons": {
    "16": "icons/favicon-96x96.png",
    "32": "icons/favicon-96x96.png",
    "48": "icons/favicon-96x96.png",
    "128": "icons/web-app-manifest-192x192.png"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["storage"],

  "host_permissions": [
    "https://warframe.market/*",
    "https://lab.webutilitykit.com/*",
    "http://49.234.200.196:80/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://warframe.market/*"],
      "js": ["content-script.js"]
    }
  ],

  "minimum_chrome_version": "88",

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://warframe.market/*"]
    }
  ]
}
